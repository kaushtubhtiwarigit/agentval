# Google Cloud / Gemini
GOOGLE_API_KEY=your_gemini_api_key_here
GCP_PROJECT_ID=your-gcp-project

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agenteval
POSTGRES_USER=eval_user
POSTGRES_PASSWORD=secure_password

# Redis (Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=agenteval
ENABLE_TRACING=true

# Model Configuration
DEFAULT_MODEL=gemini-1.5-flash
COMPLEX_MODEL=gemini-1.5-pro
ENABLE_MODEL_ROUTING=true
ROUTING_COMPLEXITY_THRESHOLD=0.7

# Semantic Cache
ENABLE_SEMANTIC_CACHE=true
CACHE_SIMILARITY_THRESHOLD=0.95
CACHE_TTL_SECONDS=3600

# Cost Optimization
GEMINI_FLASH_INPUT_COST_PER_1K=0.00015
GEMINI_FLASH_OUTPUT_COST_PER_1K=0.0006
GEMINI_PRO_INPUT_COST_PER_1K=0.00125
GEMINI_PRO_OUTPUT_COST_PER_1K=0.005

# Evaluation
EVAL_JUDGE_MODEL=gemini-1.5-pro
FAITHFULNESS_THRESHOLD=0.8
RECALL_THRESHOLD=0.75
ACCURACY_THRESHOLD=0.85
SAFETY_THRESHOLD=0.95

# API
API_HOST=0.0.0.0
API_PORT=8000
